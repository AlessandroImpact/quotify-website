# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/
#
# ATTENZIONE: Pages CONCATENA gli header quando più regole matchano lo stesso
# path, non li sovrascrive. Due regole con Cache-Control producono
# "max-age=0, ..., max-age=31536000" e vince il primo valore letto.
# Quindi ogni path deve matchare UNA SOLA regola di Cache-Control:
# su /* stanno solo gli header di sicurezza.
#
# Le pagine sono servite come URL puliti (/privacy, non /privacy.html),
# perciò vanno elencate una per una.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  ! Access-Control-Allow-Origin

# ── HTML: browser rivalida, edge Cloudflare tiene 1 ora ──
/
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/privacy
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/cookie
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/termini
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/assistenza
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

# ── Asset con hash nel nome: immutabili ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Script senza hash ──
/assistenza.js
  Cache-Control: public, max-age=86400, s-maxage=604800

# ── Immagini ──
/*.jpg
  Cache-Control: public, max-age=604800, s-maxage=2592000

/*.png
  Cache-Control: public, max-age=604800, s-maxage=2592000

/*.svg
  Cache-Control: public, max-age=604800, s-maxage=2592000

# ── Metadati crawler ──
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600

# ── llms.txt: generato dal build (scripts/seo/llms.mjs) ──
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600
